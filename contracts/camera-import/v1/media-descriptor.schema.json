{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/js051/open-eos-control/contracts/camera-import/v1/media-descriptor.schema.json",
  "title": "CameraImportMediaDescriptorV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "provider_id",
    "provider_version",
    "session_id",
    "media_id",
    "capture_correlation_id",
    "captured_at",
    "filename",
    "media_kind",
    "mime_type",
    "byte_length",
    "source_checksum",
    "source_revision",
    "camera_id",
    "camera_model",
    "storage_id",
    "storage_label",
    "width",
    "height",
    "orientation",
    "capture_group_hint",
    "companion_role",
    "available_representations",
    "range_supported",
    "resume_supported",
    "cancel_supported"
  ],
  "properties": {
    "contract_version": { "const": "1.0" },
    "provider_id": { "$ref": "#/$defs/opaqueId" },
    "provider_version": { "$ref": "#/$defs/semanticVersion" },
    "session_id": { "$ref": "#/$defs/opaqueId" },
    "media_id": { "$ref": "#/$defs/opaqueId" },
    "capture_correlation_id": { "oneOf": [{ "$ref": "#/$defs/opaqueId" }, { "type": "null" }] },
    "captured_at": { "type": ["string", "null"], "format": "date-time" },
    "filename": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255,
      "pattern": "^(?!\\.{1,2}$)[^/\\\\]+$"
    },
    "media_kind": { "enum": ["RAW", "JPEG", "HEIF", "VIDEO", "SIDECAR", "OTHER"] },
    "mime_type": {
      "type": ["string", "null"],
      "pattern": "^[a-z0-9!#$&^_.+-]+/[a-z0-9!#$&^_.+-]+$",
      "maxLength": 127
    },
    "byte_length": { "type": ["integer", "null"], "minimum": 1 },
    "source_checksum": { "oneOf": [{ "$ref": "#/$defs/sourceChecksum" }, { "type": "null" }] },
    "source_revision": { "oneOf": [{ "$ref": "#/$defs/opaqueId" }, { "type": "null" }] },
    "camera_id": { "$ref": "#/$defs/opaqueId" },
    "camera_model": { "type": "string", "minLength": 1, "maxLength": 120 },
    "storage_id": { "$ref": "#/$defs/opaqueId" },
    "storage_label": { "type": ["string", "null"], "maxLength": 120 },
    "width": { "type": ["integer", "null"], "minimum": 1 },
    "height": { "type": ["integer", "null"], "minimum": 1 },
    "orientation": { "type": ["integer", "null"], "minimum": 1, "maximum": 8 },
    "capture_group_hint": { "oneOf": [{ "$ref": "#/$defs/opaqueId" }, { "type": "null" }] },
    "companion_role": {
      "type": ["string", "null"],
      "enum": ["PRIMARY", "RAW", "JPEG", "HEIF", "VIDEO", "SIDECAR", null]
    },
    "available_representations": {
      "type": "array",
      "items": { "$ref": "#/$defs/representation" },
      "minItems": 1,
      "uniqueItems": true
    },
    "range_supported": { "type": "boolean" },
    "resume_supported": { "type": "boolean" },
    "cancel_supported": { "type": "boolean" }
  },
  "allOf": [
    {
      "if": { "properties": { "resume_supported": { "const": true } }, "required": ["resume_supported"] },
      "then": { "properties": { "range_supported": { "const": true } } }
    }
  ],
  "$defs": {
    "opaqueId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z][A-Za-z0-9._-]*$"
    },
    "semanticVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?$"
    },
    "representation": {
      "enum": ["THUMBNAIL", "PREVIEW", "ORIGINAL", "METADATA", "SIDECAR"]
    },
    "sourceChecksum": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "value", "scope"],
      "properties": {
        "algorithm": { "enum": ["SHA-256", "SHA-512", "MD5"] },
        "value": { "type": "string", "pattern": "^[0-9a-fA-F]+$" },
        "scope": { "enum": ["FULL_ORIGINAL", "FULL_REPRESENTATION", "TRANSPORT_PAYLOAD"] }
      },
      "allOf": [
        {
          "if": { "properties": { "algorithm": { "const": "SHA-256" } }, "required": ["algorithm"] },
          "then": { "properties": { "value": { "minLength": 64, "maxLength": 64 } } }
        },
        {
          "if": { "properties": { "algorithm": { "const": "SHA-512" } }, "required": ["algorithm"] },
          "then": { "properties": { "value": { "minLength": 128, "maxLength": 128 } } }
        },
        {
          "if": { "properties": { "algorithm": { "const": "MD5" } }, "required": ["algorithm"] },
          "then": { "properties": { "value": { "minLength": 32, "maxLength": 32 } } }
        }
      ]
    }
  }
}
